<?xml version="1.0" encoding="utf-8"?>
<!--
    delay_overlay.xml
    ─────────────────────────────────────────────────────────────────────────────
    Full-screen native overlay shown by AppUsageMonitor.showDelayOverlay() when a
    blocked app is foregrounded.

    Design (stitch_screens/overlay image.png):
      - Solid #121212 background (matches RN overlayTheme.sheet in design/tokens.ts).
      - Title near the top (bold), with an optional subtitle line beneath it.
      - Center: a circular countdown ring that FILLS UP (empty→full) over the wait
        seconds, with a static pause glyph inside and a "BREATHING SPACE" label below.
      - Two action buttons pinned to the bottom.

    Colors are taken from the existing React Native overlay palette (design/tokens.ts):
      background        #121212  (overlayTheme.sheet)
      primary text      #E6FFFFFF (overlayTheme.text — white 90%)
      muted text        #80FFFFFF (white 50%)
      ghost border      #33FFFFFF (overlayTheme.border)

    Layout structure:
      FrameLayout (root, match_parent × match_parent, solid #121212)
        └─ LinearLayout (vertical, fills screen)
             ├─ TextView  (title    — bold question, near top)
             ├─ TextView  (subtitle — optional extra line; gone until text is set)
             ├─ View      (weight spacer — pushes ring toward vertical center)
             ├─ FrameLayout (ring group, center horizontal)
             │     ├─ ProgressBar (countdownRing — determinate, fills over wait time)
             │     └─ ImageView   (static pause glyph, centered in the ring)
             ├─ TextView  (label    — "BREATHING SPACE" overline)
             ├─ View      (weight spacer)
             ├─ TextView  (countdownText — budget-exhausted variant only; gone)
             ├─ Button    (backButton     — "Back to Reality")
             └─ Button    (continueButton — "Wait (Xs)")

    View IDs used by AppUsageMonitor.java:
      title         — Question text; overridden by customMessage if set
      subtitle      — Optional secondary line; set via setText + VISIBLE in code
      countdownRing — ProgressBar animated 0→max over the wait seconds (fills the ring)
      backButton    — "Back to Reality" — dismisses overlay, fires ACTION_MAIN/HOME
      continueButton — "Wait (Xs)" — enabled after startContinueCountdown()
      countdownText — budget-exhausted overlay variant countdown line
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="120dp"
        android:paddingBottom="64dp">

        <!--
            title: question text, bold. Overridden in showDelayOverlay() with the
            user's customMessage if one is set, else "Is this intentional?".
        -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Is this intentional?"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#E6FFFFFF"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.3" />

        <!--
            subtitle: optional secondary line under the title (e.g. "You opened X.").
            Empty + GONE by default. AppUsageMonitor can populate it via setText() and
            setVisibility(VISIBLE) — see setOverlaySubtitle() usage there. Kept here so
            extra lines are trivial to add later without touching the layout.
        -->
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text=""
            android:textSize="16sp"
            android:textColor="#80FFFFFF"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone" />

        <!-- Spacer: pushes the ring group toward the vertical center -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ── Center: countdown ring with a static pause glyph inside ──────────── -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <!--
                countdownRing: determinate circular progress. AppUsageMonitor
                .startCountdownRing() animates `progress` 0→max over the wait seconds,
                so the white ring fills clockwise from the top as the user waits.
            -->
            <ProgressBar
                android:id="@+id/countdownRing"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:max="10000"
                android:progress="0"
                android:progressDrawable="@drawable/circular_countdown" />

            <!-- Static pause glyph centered inside the ring -->
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pause"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- "BREATHING SPACE" overline label beneath the ring -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="BREATHING SPACE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#80FFFFFF"
            android:textAlignment="center"
            android:letterSpacing="0.2" />

        <!-- Spacer: balances the top spacer so the ring sits centered -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
            countdownText: shown ONLY in the budget-exhausted overlay variant.
            Hidden by default; showBudgetExhaustedOverlay() sets it VISIBLE and
            startBudgetCountdown() updates it every second.
        -->
        <TextView
            android:id="@+id/countdownText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You can scroll again in 00:00"
            android:textSize="16sp"
            android:textColor="#CCFFFFFF"
            android:textAlignment="center"
            android:paddingBottom="24dp"
            android:visibility="gone" />

        <!--
            backButton: "Back to Reality" (primary).
            White pill, black text + back-arrow icon. Dismisses overlay, sends home.
        -->
        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Back to Reality"
            android:textSize="18sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_back"
            android:drawablePadding="10dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@drawable/white_pill_button_bg"
            android:layout_marginBottom="14dp" />

        <!--
            continueButton: "Wait (Xs)" (ghost, secondary).
            Disabled initially with an hourglass icon. startContinueCountdown() ticks
            the label down and enables this button once the countdown reaches zero.
        -->
        <Button
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Wait (3s)"
            android:textSize="15sp"
            android:textColor="#99FFFFFF"
            android:drawableStart="@drawable/ic_hourglass"
            android:drawablePadding="10dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@drawable/ghost_button_bg"
            android:enabled="false" />

    </LinearLayout>

</FrameLayout>
