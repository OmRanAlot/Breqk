<?xml version="1.0" encoding="utf-8"?>
<!--
    muted_pill_button_bg.xml
    Deliberately weak, low-emphasis pill for the discouraged "delete anyway"
    escape on the uninstall lock screen. Transparent fill + faint light-theme
    border (L.border #E5E5E5) so it reads as the lesser, regrettable choice
    next to the solid charcoal "Keep Break" button.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke
        android:width="1dp"
        android:color="#E5E5E5" />
    <corners android:radius="9999dp" />
</shape>
