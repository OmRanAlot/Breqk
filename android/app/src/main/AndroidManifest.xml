<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" 
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" 
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    


    <!-- Exact alarms for mode scheduling (Bedtime, Study Mode, etc.) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Package visibility (Android 11+, API 30+).
        QUERY_ALL_PACKAGES (above) currently grants visibility into every installed app,
        which is what VPNModule.getInstalledApps() relies on for the "Manage Apps"
        settings screen. The <queries> block below is a forward-compatible fallback:
        if/when QUERY_ALL_PACKAGES is removed (Play Store sensitive permission policy),
        we still see every launcher-visible app via this LAUNCHER intent declaration.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">

        <!-- Foreground monitoring service — keeps AppUsageMonitor alive in the background.
             NOT a VPN. Uses foregroundServiceType=specialUse to avoid OS kill. -->
        <service
            android:name=".service.BreakVpnService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

<!-- Instagram Reels and YouTube Shorts scroll intervention -->
        <service
            android:name=".ReelsInterventionService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/reels_intervention_service_config" />
        </service>

        <!--
            Mode schedule receiver.
            Handles AlarmManager intents for mode auto-activation/deactivation
            (e.g., Bedtime mode at 10pm) and re-registers alarms on boot.
            Logcat tag: MODE_SCHED
        -->
        <receiver
            android:name=".mode.ModeSchedulerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.Break.ACTION_MODE_START" />
                <action android:name="com.Break.ACTION_MODE_END" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.BreakWidgetProvider"
            android:exported="true"
            android:label="@string/widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_break_info" />
        </receiver>

        <!--
            Uninstall-lock expiry receiver.
            Fired by AlarmManager when the 24-hour (or debug 60-second) cooldown elapses.
            Also handles BOOT_COMPLETED to re-schedule the alarm after a device reboot.
            Logcat tag: UNINSTALL_LOCK
        -->
        <receiver
            android:name=".lock.UninstallExpiryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            Legacy native accessibility gate. No longer the launcher: the React
            Native onboarding (PermissionsScreen) now requests the accessibility
            permission with proper UI, so this all-black pre-RN gate is bypassed.
            Kept declared (non-launcher) in case it is opened explicitly.
            Logcat tag: ACC_PERM_GATE
        -->
        <activity
            android:name=".accessibility.AccessibilityPermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />

        <!--
            Main React Native app screen — now the cold-launch entry point.
            Onboarding (including the accessibility permission step) runs inside RN.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link for widget browser quick-launch buttons (Break://browser/instagram, Break://browser/youtube) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="Break" android:host="browser" />
            </intent-filter>
        </activity>
    </application>
</manifest>